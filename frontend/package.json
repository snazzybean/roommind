{
  "name": "roommind-frontend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build && vite build -c vite.card.config.ts && node scripts/check-bundles.mjs",
    "preview": "vite preview",
    "lint": "eslint src/",
    "format": "prettier --write src/",
    "format:check": "prettier --check src/",
    "test": "vitest run"
  },
  "dependencies": {
    "home-assistant-js-websocket": "^9.8.1",
    "lit": "^3.3.3"
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^8.72.1",
    "@typescript-eslint/parser": "^8.56.1",
    "eslint": "^10.13.0",
    "eslint-plugin-lit": "^2.3.1",
    "prettier": "^3.9.10",
    "typescript": "^6.0.3",
    "vite": "^8.3.6",
    "vitest": "^5.1.0"
  }
}
