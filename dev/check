#!/usr/bin/env bash
# Run the CI checks locally before pushing.
#
# Usage: dev/check [--quick] [--sim]
#   --quick  skip the timezone sweep (9 extra pytest runs)
#   --sim    also run the simulation suite (sim suite), see dev/sim/README.md
#
# Not covered: HACS and hassfest validation (GitHub actions only).
# Python tools come from $ROOMMIND_VENV (default: .venv in the repo root).
set -uo pipefail

# Share one CPU budget with all other sim and check runs if the host defines the slice
# (dev/sim/README.md, "CPU cap"); without it everything runs as before.
slice="${ROOMMIND_CPU_SLICE:-roommind-heavy.slice}"
if [[ $EUID -eq 0 ]] && ! grep -q "/$slice/" /proc/self/cgroup 2>/dev/null && systemctl cat "$slice" &>/dev/null; then
  exec systemd-run --scope --quiet --slice="$slice" "$0" "$@"
fi

ROOT="$(git rev-parse --show-toplevel)"
cd "$ROOT"
VENV="${ROOMMIND_VENV:-$ROOT/.venv}"
PY_BIN="$VENV/bin"
NODE_BIN="$ROOT/frontend/node_modules/.bin"
SIM_JOBS="${SIM_JOBS:-4}"

quick=0
sim=0
for arg in "$@"; do
  case "$arg" in
    --quick) quick=1 ;;
    --sim) sim=1 ;;
    -h | --help)
      sed -n '2,9p' "$0" | sed 's/^# \{0,1\}//'
      exit 0
      ;;
    *)
      echo "dev/check: unknown option $arg" >&2
      exit 2
      ;;
  esac
done

for tool in "$PY_BIN/pytest" "$PY_BIN/ruff" "$PY_BIN/mypy" "$NODE_BIN/tsc" "$NODE_BIN/eslint" "$NODE_BIN/prettier" "$NODE_BIN/vitest"; do
  if [[ ! -x "$tool" ]]; then
    echo "dev/check: missing $tool (pip install -r requirements-dev.txt ruff mypy / npm ci in frontend)" >&2
    exit 2
  fi
done

LOG_DIR="$(mktemp -d)"
trap 'rm -rf "$LOG_DIR"' EXIT
failed=()
n=0

step() {
  local name="$1"
  shift
  n=$((n + 1))
  local log="$LOG_DIR/$n.log"
  local start=$SECONDS
  printf '%-46s' "$name"
  if "$@" >"$log" 2>&1; then
    printf 'ok   %3ss\n' $((SECONDS - start))
  else
    printf 'FAIL %3ss\n' $((SECONDS - start))
    tail -n 40 "$log" | sed 's/^/    /'
    failed+=("$name")
  fi
}

in_frontend() { (cd "$ROOT/frontend" && "$@"); }

step "ruff check" "$PY_BIN/ruff" check custom_components/ tests/
step "ruff format" "$PY_BIN/ruff" format --check custom_components/ tests/
step "mypy" "$PY_BIN/mypy" custom_components/roommind/
step "pytest + coverage >= 95 %" "$PY_BIN/pytest" tests/ -q -p no:sugar \
  --cov=custom_components/roommind --cov-report=term --cov-fail-under=95
step "tsc" in_frontend "$NODE_BIN/tsc" --noEmit
step "eslint" in_frontend "$NODE_BIN/eslint" src/
step "prettier" in_frontend "$NODE_BIN/prettier" --check src/
step "vitest" in_frontend "$NODE_BIN/vitest" run
step "vite build" in_frontend npm run build --silent

if [[ $quick -eq 0 ]]; then
  for os_tz in UTC US/Pacific Australia/Sydney; do
    for ha_tz in UTC US/Pacific Australia/Sydney; do
      step "tz sweep $os_tz / $ha_tz" env TZ="$os_tz" ROOMMIND_TEST_TZ="$ha_tz" \
        "$PY_BIN/pytest" tests/utils/test_schedule_utils.py -q -p no:sugar -o asyncio_mode=auto
    done
  done
fi

if [[ $sim -eq 1 ]]; then
  step "sim suite" "$ROOT/dev/sim/bin/sim" suite -j "$SIM_JOBS"
fi

echo
if [[ ${#failed[@]} -eq 0 ]]; then
  echo "dev/check: all $n checks passed"
  exit 0
fi
echo "dev/check: ${#failed[@]} of $n failed: ${failed[*]}"
exit 1
