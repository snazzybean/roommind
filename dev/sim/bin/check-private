#!/usr/bin/env python3
"""Refuse private data (LAN IPs, local paths, tokens, emails) in what is about to be committed.

Usage: dev/sim/bin/check-private [paths...]
Without paths it checks only the lines a commit adds (staged diff), so existing content
elsewhere in the repo (example IPs, test fixtures) does not block unrelated commits.
Extra local patterns (names, coordinates, hostnames) can live outside the repo in
$ROOMMIND_SIM_HOME/private-patterns.txt, one regex per line.
"""

from __future__ import annotations

import os
import re
import subprocess
import sys
from pathlib import Path

PATTERNS = {
    "private IPv4": r"\b(?:10\.\d{1,3}|192\.168|172\.(?:1[6-9]|2\d|3[01]))\.\d{1,3}\.\d{1,3}\b",
    "local path": r"(?<![\w.])/(?:srv|root|home/[a-z][\w-]*|Users/[\w.-]+)/",
    "email": r"\b[A-Za-z0-9._%+-]+@(?!example\.(?:com|org))[A-Za-z0-9.-]+\.[a-z]{2,}\b",
    "JWT/token": r"\beyJ[A-Za-z0-9_-]{10,}\.[A-Za-z0-9_-]{10,}",
    "token literal": r"(?i)(?:bearer\s+[A-Za-z0-9_\-.]{30,}|token[\"']?\s*[:=]\s*[\"'][A-Za-z0-9_\-.]{30,}[\"'])",
    "MCP private URL": r"private_[A-Za-z0-9]{12,}",
}
ALLOW_MARK = "check-private: allow"


def staged_lines() -> list[tuple[str, int, str]]:
    diff = subprocess.run(
        ["git", "diff", "--cached", "--unified=0", "--no-color", "--diff-filter=ACMR"],
        capture_output=True,
        text=True,
        check=True,
    ).stdout
    out: list[tuple[str, int, str]] = []
    path, lineno = "", 0
    for line in diff.splitlines():
        if line.startswith("+++ "):
            path = line[6:] if line.startswith("+++ b/") else line[4:]
        elif line.startswith("@@"):
            lineno = int(line.split("+", 1)[1].split(",")[0].split(" ")[0]) - 1
        elif line.startswith("+") and not line.startswith("+++"):
            lineno += 1
            out.append((path, lineno, line[1:]))
    return out


def file_lines(paths: list[Path]) -> list[tuple[str, int, str]]:
    out: list[tuple[str, int, str]] = []
    for path in paths:
        if not path.is_file() or path.suffix in {".png", ".jpg", ".gz", ".ico", ".woff2"}:
            continue
        try:
            text = path.read_text()
        except UnicodeDecodeError:
            continue
        out.extend((str(path), i, line) for i, line in enumerate(text.splitlines(), 1))
    return out


def load_patterns() -> dict[str, re.Pattern[str]]:
    patterns = dict(PATTERNS)
    home = Path(os.environ.get("ROOMMIND_SIM_HOME", Path.home() / ".roommind-sim"))
    extra = home / "private-patterns.txt"
    if extra.is_file():
        for i, line in enumerate(extra.read_text().splitlines()):
            if line.strip() and not line.startswith("#"):
                patterns[f"local pattern {i + 1}"] = line.strip()
    return {name: re.compile(rx) for name, rx in patterns.items()}


def main(argv: list[str]) -> int:
    lines = file_lines([Path(a) for a in argv]) if argv else staged_lines()
    patterns = load_patterns()
    hits = []
    for path, lineno, line in lines:
        if ALLOW_MARK in line:
            continue
        for name, rx in patterns.items():
            if rx.search(line):
                hits.append(f"{path}:{lineno}: {name}: {line.strip()[:120]}")
    if hits:
        print("Private data found, not committing:", *hits, sep="\n  ", file=sys.stderr)
        return 1
    print(f"check-private: {len(lines)} line(s) clean")
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
